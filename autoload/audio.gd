extends Node
## Sound effects, music and ambience (PLAN.md section 18). All sounds are generated by
## tools/audio/generate_audio.py; names here must match its output. Buses Music, SFX and
## Ambience are created at startup and follow the volume settings.

## Every sound effect in res://audio/sfx/ (listed explicitly so exported builds find them).
const SOUNDS: Array[StringName] = [
	&"slash_1", &"slash_2", &"slash_3", &"slash_air", &"dodge", &"jump", &"land", &"hit_light",
	&"hit_heavy", &"execute", &"parry", &"guard", &"deflect", &"draw_charge", &"draw_strike",
	&"slam_dive", &"slam_land", &"hurt", &"death", &"machine_death", &"laser", &"drone_charge",
	&"hound_windup", &"linked_grab", &"cut_link", &"freed", &"focus_on", &"focus_off",
	&"rank_up", &"ember_burst", &"slice", &"clank", &"scrap_pop",
]
const POOL_SIZE := 16
const BUSES: Array[String] = ["Music", "SFX", "Ambience"]

var _streams: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _next: int = 0
var _music: AudioStreamPlayer
var _ambience: AudioStreamPlayer
## Off in headless runs (tests, bots): the silent driver never finishes sounds, so they'd
## be reported as leaked at quit.
var _enabled: bool = true


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_enabled = DisplayServer.get_name() != "headless"
	for bus in BUSES:
		_ensure_bus(bus)
	for sound in SOUNDS:
		_streams[sound] = load("res://audio/sfx/%s.wav" % sound)
	for i in POOL_SIZE:
		_pool.append(_player("SFX"))
	_music = _player("Music")
	_ambience = _player("Ambience")
	apply_volume_settings()


func _exit_tree() -> void:
	# Stop and release everything so no playback is reported as leaked on quit.
	for player: AudioStreamPlayer in _pool + [_music, _ambience]:
		player.stop()
		player.stream = null
	_streams.clear()


## Plays a sound effect. pitch_jitter randomizes pitch a little so repeats don't sound robotic.
func play(sound: StringName, volume_db: float = 0.0, pitch_jitter: float = 0.06, pitch: float = 1.0) -> void:
	if not _enabled:
		return
	var stream: AudioStream = _streams.get(sound)
	if stream == null:
		push_warning("Audio: unknown sound '%s'" % sound)
		return
	var player := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = pitch * randf_range(1.0 - pitch_jitter, 1.0 + pitch_jitter)
	player.play()


## Starts a looping music track (does nothing if it's already playing).
func play_music(path: String, volume_db: float = -6.0) -> void:
	_loop(_music, path, volume_db)


func play_ambience(path: String, volume_db: float = -12.0) -> void:
	_loop(_ambience, path, volume_db)


## Focus slow motion: music drops in pitch so time feels slowed.
func set_slow_motion(enabled: bool) -> void:
	_music.pitch_scale = 0.8 if enabled else 1.0
	play(&"focus_on" if enabled else &"focus_off", -4.0, 0.0)


func apply_volume_settings() -> void:
	var master := float(Settings.get_value("audio", "master"))
	AudioServer.set_bus_volume_db(0, linear_to_db(master))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_to_db(float(Settings.get_value("audio", "music"))))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_to_db(float(Settings.get_value("audio", "sfx"))))


func _loop(player: AudioStreamPlayer, path: String, volume_db: float) -> void:
	if not _enabled:
		return
	var stream := load(path) as AudioStreamWAV
	if player.stream == stream and player.playing:
		return
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	player.stream = stream
	player.volume_db = volume_db
	player.play()


func _player(bus: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.bus = bus
	add_child(player)
	return player


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var index := AudioServer.bus_count - 1
	AudioServer.set_bus_name(index, bus_name)
	AudioServer.set_bus_send(index, "Master")
