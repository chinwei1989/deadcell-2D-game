[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="one_way"
2d_physics/layer_3="player_body"
2d_physics/layer_4="enemy_body"
2d_physics/layer_5="player_attack"
2d_physics/layer_6="enemy_attack"
2d_physics/layer_7="player_hurtbox"
2d_physics/layer_8="enemy_hurtbox"
2d_physics/layer_9="pickups"
2d_physics/layer_10="interactables"
2d_physics/layer_11="hazards"
2d_physics/layer_12="projectiles"
2d_physics/layer_13="deflected"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.043137256, 0.08627451, 0.1254902, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
